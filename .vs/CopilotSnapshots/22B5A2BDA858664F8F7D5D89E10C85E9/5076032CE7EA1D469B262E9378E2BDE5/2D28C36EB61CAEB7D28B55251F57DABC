import { useEffect, useRef, useState } from "react";
import { FaChevronDown, FaExclamationCircle, FaFutbol } from "react-icons/fa";

export default function FilaProgramacion({
                                             tarjeta,
                                             opciones,
                                             equipoYaProgramado,
                                             open,
                                             onOpen,
                                             onClose,
                                             onSelect,
                                         }) {
    const ref = useRef(null);
    const [abreHaciaArriba, setAbreHaciaArriba] = useState(false);

    useEffect(() => {
        const handler = (e) => {
            if (ref.current && !ref.current.contains(e.target)) {
                onClose();
            }
        };
        document.addEventListener("click", handler);
        return () => document.removeEventListener("click", handler);
    }, [onClose]);

    const handleToggle = (e) => {
        e.stopPropagation();
        if (!open) {
            const rect = ref.current.getBoundingClientRect();
            const espacioDisponibleAbajo = window.innerHeight - rect.bottom;
            setAbreHaciaArriba(espacioDisponibleAbajo < 300);
            onOpen();
        } else {
            onClose();
        }
    };

    const seleccionar = (op) => {
        onSelect(op);
        onClose();
    };

    return (
        <div
            ref={ref}
            style={{ zIndex: open ? 100 : 10 }}
            className={`
                flex flex-col sm:flex-row items-center gap-5 sm:gap-8 
                bg-[#0a0f2c] border rounded-[2rem] 
                p-6 sm:px-8 sm:py-4 transition-all duration-300 
                w-full sm:w-fit mb-4 shadow-xl relative
                ${open ? "border-cyan-500 shadow-cyan-900/20" : "border-slate-800"}
            `}
        >
            {/* EQUIPO BASE CON ESCUDO */}
            <div className="flex items-center gap-4 w-full sm:w-[280px]">
                {/* CONTENEDOR DEL ESCUDO */}
                <div className="w-10 h-10 rounded-full bg-[#040714] border border-slate-800 flex items-center justify-center shrink-0 overflow-hidden shadow-inner">
                    {tarjeta.escudo ? (
                        <img
                            src={tarjeta.escudo}
                            alt={tarjeta.equipoNombre}
                            className="w-full h-full object-contain p-1.5"
                        />
                    ) : (
                        <FaFutbol className="text-slate-700 text-sm" />
                    )}
                </div>

                <div className="flex flex-col text-left overflow-hidden">
                    <span className="font-bold text-lg md:text-xl uppercase tracking-tight text-white leading-none truncate">
                        {tarjeta.equipoNombre}
                    </span>

                    {equipoYaProgramado && (
                        <div className="flex items-center gap-1.5 mt-1 text-red-500">
                            <FaExclamationCircle size={10} />
                            <span className="text-[10px] uppercase font-bold tracking-wider">
                                Ya programado
                            </span>
                        </div>
                    )}
                </div>
            </div>

            {/* DIVISOR VS */}
            <span className="text-slate-800 font-bold text-sm hidden sm:block">VS</span>

            {/* SELECTOR DE RIVAL */}
            <div className="relative w-full sm:w-64">
                <button
                    type="button"
                    onClick={handleToggle}
                    className={`
                        w-full h-12 flex justify-between items-center px-6 rounded-xl border transition-all font-bold text-xs uppercase tracking-widest
                        ${open
                        ? "bg-cyan-600 border-cyan-500 text-white shadow-lg shadow-cyan-900/40"
                        : "bg-[#040714] border-slate-800 text-slate-400 hover:border-slate-600 hover:text-white"}
                    `}
                >
                    <span className="truncate">{open ? "Elegir Rival..." : "Seleccionar"}</span>
                    <FaChevronDown className={`text-[10px] transition-transform duration-300 ${open ? "rotate-180" : ""}`} />
                </button>

                {open && (
                    <div className={`
                        absolute z-[110] w-full sm:w-80 bg-[#0a0f2c] border border-slate-800 
                        rounded-2xl shadow-2xl max-h-72 overflow-y-auto left-0
                        ${abreHaciaArriba ? "bottom-full mb-3" : "top-full mt-3"}
                    `}>
                        {opciones.length === 0 ? (
                            <div className="px-6 py-8 text-[10px] text-slate-600 text-center uppercase font-bold tracking-widest">
                                Sin rivales disponibles
                            </div>
                        ) : (
                            opciones.map((op) => (
                                <button
                                    key={op.partidoId}
                                    type="button"
                                    onMouseDown={(e) => {
                                        e.preventDefault();
                                        seleccionar(op);
                                    }}
                                    className="w-full text-left px-6 py-4 text-[11px] text-slate-300 font-bold uppercase hover:bg-cyan-600 hover:text-white border-b border-slate-800/50 last:border-0 transition-all flex items-center gap-4 tracking-wider"
                                >
                                    <span className="text-slate-700 font-bold text-[9px]">VS</span>
                                    <span className="truncate">{op.vs}</span>
                                </button>
                            ))
                        )}
                    </div>
                )}
            </div>
        </div>
    );
}