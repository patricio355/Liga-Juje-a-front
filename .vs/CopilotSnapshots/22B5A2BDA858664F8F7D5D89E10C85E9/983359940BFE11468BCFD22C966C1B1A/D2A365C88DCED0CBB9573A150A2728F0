import { useState } from "react";
import { createPortal } from "react-dom";
import { FaEdit, FaTrash, FaCircle, FaShieldAlt, FaExclamationTriangle, FaTimes } from "react-icons/fa";

export default function EquipoCard({ equipo, onEdit, onDelete, onEliminarInscripcion }) {
    const [showConfirm, setShowConfirm] = useState(false);
    const [confirmText, setConfirmText] = useState("");

    const inscripciones = equipo.inscripciones || [];

    const handleConfirmDelete = () => {
        if (confirmText.toUpperCase() === "CONFIRMAR") {
            onDelete(equipo.id);
            setShowConfirm(false);
            setConfirmText("");
        }
    };

    return (
        <>
            <div className="bg-[#0a0c10] border border-white/5 rounded-[2rem] p-5 md:p-6 hover:border-white/20 transition-all duration-500 flex flex-col md:flex-row md:items-center justify-between gap-6 group shadow-2xl relative overflow-hidden">
                {/* Brillo de fondo al hacer hover */}
                <div className="absolute inset-0 bg-gradient-to-r from-slate-400/0 via-slate-400/0 to-slate-400/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

                <div className="flex flex-1 items-start md:items-center gap-6 relative z-10">
                    {/* ESCUDO */}
                    <div className="shrink-0 w-16 h-16 bg-black rounded-2xl border border-white/10 p-2.5 flex items-center justify-center shadow-2xl group-hover:border-white/30 transition-colors">
                        {equipo.escudo ? (
                            <img src={equipo.escudo} alt={equipo.nombre} className="w-full h-full object-contain opacity-90 group-hover:opacity-100" />
                        ) : (
                            <FaShieldAlt className="text-slate-800 text-2xl" />
                        )}
                    </div>

                    <div className="space-y-4 flex-1">
                        <div className="flex flex-wrap items-center gap-4">
                            <h3 className="text-xl font-black text-white italic uppercase tracking-tighter">{equipo.nombre}</h3>
                            <div className={`flex items-center gap-1.5 px-3 py-1 rounded-full border text-[9px] font-black uppercase tracking-[0.2em] ${equipo.estado ? 'bg-white/5 border-white/10 text-slate-300' : 'bg-red-900/10 border-red-900/20 text-red-500'}`}>
                                <FaCircle size={5} className={equipo.estado ? 'text-slate-400 animate-pulse' : 'text-red-600'} />
                                <span>{equipo.estado ? "Activo" : "Inactivo"}</span>
                            </div>
                        </div>


                    </div>
                </div>

                {/* ACCIONES */}
                <div className="flex items-center justify-end gap-3 border-t border-white/5 md:border-0 pt-4 md:pt-0 relative z-10">
                    <button onClick={() => onEdit(equipo)} className="p-3.5 bg-white/5 border border-white/10 text-slate-400 hover:bg-white hover:text-black rounded-2xl transition-all active:scale-95">
                        <FaEdit size={16} />
                    </button>
                    <button onClick={() => setShowConfirm(true)} className="p-3.5 bg-white/5 border border-white/10 text-slate-800 hover:bg-red-600 hover:text-white rounded-2xl transition-all active:scale-95">
                        <FaTrash size={16} />
                    </button>
                </div>
            </div>

            {/* MODAL DE CONFIRMACIÓN (Portal) */}
            {showConfirm && createPortal(
                <div className="fixed inset-0 bg-black/95 backdrop-blur-xl flex items-center justify-center z-[999999] p-4" onClick={() => setShowConfirm(false)}>
                    <div className="bg-[#05070a] border border-white/10 rounded-[2.5rem] w-full max-w-md p-8 shadow-[0_0_100px_rgba(255,0,0,0.1)] animate-in fade-in zoom-in duration-200" onClick={e => e.stopPropagation()}>
                        <div className="flex flex-col items-center text-center">
                            <div className="w-16 h-16 bg-red-500/10 rounded-2xl flex items-center justify-center mb-6 border border-red-500/20">
                                <FaExclamationTriangle className="text-red-500" size={30} />
                            </div>

                            <h2 className="text-xl font-black text-white italic uppercase tracking-tighter mb-2">Eliminar Equipo</h2>
                            <p className="text-[11px] font-bold text-slate-400 uppercase tracking-widest leading-relaxed mb-6">
                                Al eliminar este equipo ya no podrá ser elegido en nuevos torneos, pero seguirá apareciendo en los que ya participó.
                                <br/><br/>
                                <span className="text-slate-600">Para quitarlo de un torneo actual, hazlo desde la gestión del mismo.</span>
                            </p>

                            <div className="w-full space-y-4">
                                <div className="space-y-2 text-left">
                                    <label className="text-[9px] font-black text-slate-600 uppercase tracking-[0.2em] ml-2">Escribe CONFIRMAR para continuar</label>
                                    <input
                                        type="text"
                                        placeholder="CONFIRMAR"
                                        className="w-full bg-black border border-white/5 rounded-2xl px-6 py-5 text-center text-sm font-black text-red-500 outline-none focus:border-red-500/50 transition-all uppercase"
                                        value={confirmText}
                                        onChange={(e) => setConfirmText(e.target.value.toUpperCase())}
                                        autoFocus
                                    />
                                </div>

                                <div className="flex gap-4 pt-2">
                                    <button
                                        onClick={() => { setShowConfirm(false); setConfirmText(""); }}
                                        className="flex-1 py-5 rounded-2xl text-[10px] font-black uppercase tracking-[0.2em] text-slate-500 border border-white/5 hover:bg-white/5 transition-all"
                                    >
                                        Cancelar
                                    </button>
                                    <button
                                        disabled={confirmText !== "CONFIRMAR"}
                                        onClick={handleConfirmDelete}
                                        className="flex-1 py-5 bg-red-600 hover:bg-red-500 disabled:opacity-20 rounded-2xl text-[10px] font-black uppercase tracking-[0.2em] text-white transition-all shadow-lg shadow-red-600/20"
                                    >
                                        Eliminar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>,
                document.body
            )}
        </>
    );
}