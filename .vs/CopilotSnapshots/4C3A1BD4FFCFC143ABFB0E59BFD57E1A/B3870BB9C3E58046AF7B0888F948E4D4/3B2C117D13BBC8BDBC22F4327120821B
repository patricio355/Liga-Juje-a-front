import { useEffect, useState, useCallback } from "react";
import { apiFetch } from "../../api/api";
import {
    FaMapMarkerAlt,
    FaPlus,
    FaTrashAlt,
    FaEdit,
    FaSearch,
    FaSync,
    FaExternalLinkAlt,
    FaTicketAlt
} from "react-icons/fa";
import Swal from "sweetalert2";
import ModalCancha from "../modal/ModalCancha";

export default function CanchasList() {
    const [canchas, setCanchas] = useState([]);
    const [loading, setLoading] = useState(true);
    const [busqueda, setBusqueda] = useState("");
    const [modalOpen, setModalOpen] = useState(false);
    const [canchaAEditar, setCanchaAEditar] = useState(null);

    const cargarCanchas = async () => {
        try {
            setLoading(true);
            const data = await apiFetch("/api/canchas");
            setCanchas(data || []);
        } catch (error) {
            console.error("Error cargando canchas:", error);
        } finally {
            setLoading(false);
        }
    };

    useEffect(() => { cargarCanchas(); }, []);

    const eliminarCancha = (id) => {
        Swal.fire({
            title: "¿ELIMINAR CANCHA?",
            text: "Se borrará permanentemente del sistema.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#ffffff",
            cancelButtonColor: "#1a1a1a",
            confirmButtonText: "SÍ, ELIMINAR",
            background: "#0a0a0a",
            color: "#fff"
        }).then(async (result) => {
            if (result.isConfirmed) {
                try {
                    await apiFetch(`/api/canchas/${id}`, { method: "DELETE" });
                    cargarCanchas();
                } catch (e) {
                    Swal.fire("ERROR", "No se pudo eliminar", "error");
                }
            }
        });
    };

    const filtradas = canchas.filter(c =>
        c.nombre?.toLowerCase().includes(busqueda.toLowerCase()) ||
        c.ubicacion?.toLowerCase().includes(busqueda.toLowerCase())
    );

    return (
        <div className="space-y-10 animate-in fade-in duration-500">

            {/* TOOLBAR */}
            <div className="flex flex-col md:flex-row gap-4 justify-between items-center bg-[#0a0a0a] p-6 rounded-[2.5rem] border border-white/5">
                <div className="relative w-full md:w-96">
                    <FaSearch className="absolute left-5 top-1/2 -translate-y-1/2 text-slate-600" />
                    <input
                        type="text"
                        placeholder="BUSCAR PREDIO..."
                        className="w-full bg-black border border-white/10 rounded-2xl py-4 pl-14 pr-4 text-xs font-black text-white outline-none focus:border-white/30 transition-all uppercase tracking-[0.2em]"
                        value={busqueda}
                        onChange={(e) => setBusqueda(e.target.value)}
                    />
                </div>

                <button
                    onClick={() => { setCanchaAEditar(null); setModalOpen(true); }}
                    className="w-full md:w-auto bg-white text-black px-10 py-4 rounded-2xl font-black text-[10px] uppercase tracking-widest flex items-center justify-center gap-3 hover:bg-slate-200 transition-all shadow-[0_10px_30px_-10px_rgba(255,255,255,0.3)] active:scale-95"
                >
                    <FaPlus /> Registrar Predio
                </button>
            </div>

            {/* GRILLA */}
            {loading ? (
                <div className="py-32 flex flex-col items-center gap-4 opacity-40">
                    <FaSync className="animate-spin text-white text-4xl" />
                </div>
            ) : (
                <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
                    {filtradas.map(cancha => (
                        <div key={cancha.id} className="bg-[#0a0a0a] border border-white/5 rounded-[2.5rem] overflow-hidden group hover:border-white/20 transition-all flex flex-col shadow-2xl">

                            {/* IMAGEN GRANDE (PORTADA) */}
                            <div className="relative h-56 w-full bg-black overflow-hidden">
                                {cancha.fotoUrl ? (
                                    <img
                                        src={cancha.fotoUrl}
                                        alt={cancha.nombre}
                                        className="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 opacity-70 group-hover:opacity-100"
                                    />
                                ) : (
                                    <div className="w-full h-full flex items-center justify-center bg-gradient-to-br from-slate-900 to-black text-white/10">
                                        <FaMapMarkerAlt size={60} />
                                    </div>
                                )}

                                {/* Badge de Precio sobre la imagen */}
                                <div className="absolute bottom-4 left-6 bg-white text-black px-4 py-1.5 rounded-full text-[9px] font-black uppercase tracking-tighter shadow-xl">
                                    <FaTicketAlt className="inline mr-2" />
                                    ${cancha.valorEntrada || 0}
                                </div>
                            </div>

                            {/* CONTENIDO INFREIOR */}
                            <div className="p-8 space-y-4">
                                <div>
                                    <h3 className="text-xl font-black text-white uppercase tracking-tighter leading-tight">
                                        {cancha.nombre}
                                    </h3>

                                    <p className="text-[10px] font-bold text-slate-500 uppercase mt-1">
                                        {cancha.ubicacion || "SIN DIRECCIÓN"}
                                    </p>

                                    {/* Link a Maps condicional */}
                                    {cancha.ubicacionUrl && (
                                        <a
                                            href={cancha.ubicacionUrl}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            className="inline-flex items-center gap-2 mt-3 text-[10px] font-black text-blue-400 hover:text-white transition-colors uppercase tracking-[0.2em] border-b border-blue-400/20 pb-1"
                                        >
                                            <FaMapMarkerAlt />
                                            Ver Ubicación
                                            <FaExternalLinkAlt size={8} />
                                        </a>
                                    )}
                                </div>

                                {/* BOTONES DE ACCIÓN */}
                                <div className="flex gap-3 pt-4">
                                    <button
                                        onClick={() => { setCanchaAEditar(cancha); setModalOpen(true); }}
                                        className="flex-1 bg-white/5 hover:bg-white/10 border border-white/10 py-4 rounded-2xl text-[9px] font-black text-white uppercase tracking-[0.2em] transition-all flex items-center justify-center gap-2"
                                    >
                                        <FaEdit /> Editar
                                    </button>
                                    <button
                                        onClick={() => eliminarCancha(cancha.id)}
                                        className="px-6 bg-red-500/10 hover:bg-red-500 text-red-500 hover:text-white border border-red-500/20 py-4 rounded-2xl transition-all active:scale-95"
                                    >
                                        <FaTrashAlt />
                                    </button>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            )}

            <ModalCancha
                open={modalOpen}
                cancha={canchaAEditar}
                onClose={() => setModalOpen(false)}
                onSuccess={cargarCanchas}
            />
        </div>
    );
}